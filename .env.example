# Copie para `.env` e preencha. O `.env` nao vai para o git.

# --- Modelo -----------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=sua_api_key_do_google_ai_studio

# Modelo dos sub agentes de leitura (barato e rapido)
GTM_MODEL_FAST=gemini-3.1-flash-lite
# Modelo do agente raiz e dos sub agentes que raciocinam mais
GTM_MODEL_REASONING=gemini-3.5-flash

# --- Contexto GTM padrao ----------------------------------------------------
# Encontre os ids na URL do GTM:
# tagmanager.google.com/#/container/accounts/<ACCOUNT_ID>/containers/<CONTAINER_ID>/workspaces/<WORKSPACE_ID>
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
GTM_WORKSPACE_ID=2

# --- Credenciais OAuth (caminhos relativos a raiz do projeto) ---------------
GTM_CLIENT_SECRET_FILE=credentials/client_secret.json
GTM_TOKEN_FILE=credentials/token.pickle

# --- Documentacao -----------------------------------------------------------
GTM_DEFAULT_DOCS_DIR=default_docs
GTM_CUSTOM_DOCS_DIR=custom_docs
GTM_SKILLS_DIR=gtm_agent/skills

# --- Seguranca --------------------------------------------------------------
# true = ferramentas de escrita apenas mostram o payload, sem gravar no GTM
GTM_DRY_RUN=false
