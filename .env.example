# Copy to `.env` and fill in. `.env` is not committed.

# ============================================================================
# MODEL PROVIDER
# See docs/model_providers.md for a copy-paste block per provider.
# google | anthropic | vertex_anthropic | litellm
# ============================================================================
GTM_MODEL_PROVIDER=google

# Model for the read-only agents (listing). Cheap and fast is enough.
GTM_MODEL_FAST=gemini-3.1-flash-lite
# Model for the root agent and the agents that plan and write.
GTM_MODEL_REASONING=gemini-3.1-flash-lite
# Output token cap. Anthropic providers only; Gemini and LiteLLM use their own.
GTM_MODEL_MAX_TOKENS=16000

# --- Credentials: pick the block matching GTM_MODEL_PROVIDER ---------------

# google (Google AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_key_from_aistudio.google.com

# anthropic          -> pip install anthropic
#   GTM_MODEL_FAST=claude-haiku-4-5
#   GTM_MODEL_REASONING=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# vertex_anthropic   -> pip install "anthropic[vertex]"
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-east5

# litellm            -> pip install litellm
#   GTM_MODEL_FAST=openai/gpt-4o-mini
#   GTM_MODEL_REASONING=openai/gpt-4o
# OPENAI_API_KEY=sk-...

# ============================================================================
# GTM CONTEXT
# Find the ids in the GTM URL:
# tagmanager.google.com/#/container/accounts/<ACCOUNT_ID>/containers/<CONTAINER_ID>/workspaces/<WORKSPACE_ID>
# ============================================================================
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
GTM_WORKSPACE_ID=

# --- OAuth credentials (paths relative to the project root) ----------------
GTM_CLIENT_SECRET_FILE=credentials/client_secret.json
GTM_TOKEN_FILE=credentials/token.pickle

# ============================================================================
# DOCUMENTATION
# ============================================================================
GTM_DEFAULT_DOCS_DIR=default_docs
GTM_CUSTOM_DOCS_DIR=custom_docs
GTM_SKILLS_DIR=gtm_agent/skills

# ============================================================================
# SAFETY
# true = write tools only show the payload; nothing is written to GTM
# ============================================================================
GTM_DRY_RUN=false
